{
  "_comment": "Parity corpus. Each case is one tools/call. A case with parity_deviation is a documented, intended difference: the checker reports it instead of failing. Query cases give collection+pipeline (tool query_data_collections); tool cases give tool+arguments. 'covers' names the behaviour (PLAN §1A.6) the case pins.",
  "cases": [
    {"id": "match-literal", "server": "default", "collection": "order", "covers": "$match literal → equality", "pipeline": [{"$match": {"status": "paid"}}, {"$sort": {"id": 1}}, {"$project": {"id": 1, "number": 1, "status": 1}}]},
    {"id": "match-eq", "server": "default", "collection": "order", "covers": "$eq", "pipeline": [{"$match": {"status": {"$eq": "shipped"}}}, {"$sort": {"id": 1}}, {"$project": {"number": 1}}]},
    {"id": "match-eq-null", "server": "default", "collection": "order", "covers": "$eq null → isnull", "pipeline": [{"$match": {"billing_identity": {"$eq": null}}}, {"$group": {"_id": null, "n": {"$sum": 1}}}]},
    {"id": "match-ne", "server": "default", "collection": "order", "covers": "$ne (negated Q)", "pipeline": [{"$match": {"status": {"$ne": "cancelled"}}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "status": 1}}]},
    {"id": "match-ne-null", "server": "default", "collection": "order", "covers": "$ne null → NOT isnull", "pipeline": [{"$match": {"billing_identity": {"$ne": null}}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "billing_identity": 1}}]},
    {"id": "match-gt-lt-decimal", "server": "default", "collection": "order", "covers": "$gt/$lt on a decimal", "pipeline": [{"$match": {"total": {"$gt": 500, "$lt": 2000}}}, {"$sort": {"total": 1}}, {"$project": {"number": 1, "total": 1}}]},
    {"id": "match-gte-lte-datetime", "server": "default", "collection": "order", "covers": "$gte/$lte on a datetime with ISO strings", "pipeline": [{"$match": {"placed_at": {"$gte": "2025-01-01T00:00:00Z", "$lte": "2025-06-30T23:59:59Z"}}}, {"$sort": {"placed_at": 1}}, {"$project": {"number": 1, "placed_at": 1}}]},
    {"id": "match-date-field", "server": "default", "collection": "customer", "covers": "$gt on a date field", "pipeline": [{"$match": {"signed_up_on": {"$gt": "2023-06-01"}}}, {"$sort": {"signed_up_on": 1}}, {"$project": {"name": 1, "signed_up_on": 1}}]},
    {"id": "match-in", "server": "default", "collection": "order", "covers": "$in", "pipeline": [{"$match": {"status": {"$in": ["paid", "shipped"]}}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "status": 1}}]},
    {"id": "match-nin", "server": "default", "collection": "order", "covers": "$nin (negated in)", "pipeline": [{"$match": {"status": {"$nin": ["paid", "shipped"]}}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "status": 1}}]},
    {"id": "match-regex", "server": "default", "collection": "product", "covers": "$regex (case-sensitive)", "pipeline": [{"$match": {"name": {"$regex": "^[A-G]"}}}, {"$sort": {"sku": 1}}, {"$project": {"sku": 1, "name": 1}}]},
    {"id": "match-and", "server": "default", "collection": "order", "covers": "$and", "pipeline": [{"$match": {"$and": [{"status": "pending"}, {"total": {"$gt": 300}}]}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "total": 1}}]},
    {"id": "match-or", "server": "default", "collection": "order", "covers": "$or", "pipeline": [{"$match": {"$or": [{"status": "cancelled"}, {"total": {"$lt": 200}}]}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "status": 1, "total": 1}}]},
    {"id": "match-nor", "server": "default", "collection": "order", "covers": "$nor", "pipeline": [{"$match": {"$nor": [{"status": "cancelled"}, {"status": "pending"}]}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "status": 1}}]},
    {"id": "match-or-ignores-siblings", "server": "default", "collection": "order", "covers": "keys next to $or are silently dropped (returns early)", "pipeline": [{"$match": {"$or": [{"status": "paid"}, {"status": "shipped"}], "customer": 2}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "customer": 1}}]},
    {"id": "match-underscore-id", "server": "default", "collection": "order", "covers": "_id → pk", "pipeline": [{"$match": {"_id": 3}}, {"$project": {"id": 1, "number": 1}}]},
    {"id": "match-fk-by-name", "server": "default", "collection": "order", "covers": "FK by field name", "pipeline": [{"$match": {"customer": 2}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "customer": 1}}]},
    {"id": "match-fk-by-column", "server": "default", "collection": "order", "covers": "FK by attname customer_id", "pipeline": [{"$match": {"customer_id": 2}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "customer_id": 1}}]},
    {"id": "match-bool", "server": "default", "collection": "product", "covers": "boolean literal", "pipeline": [{"$match": {"in_stock": false}}, {"$sort": {"sku": 1}}, {"$project": {"sku": 1, "in_stock": 1}}]},
    {"id": "match-unsupported-op", "server": "default", "collection": "order", "covers": "unknown operator → error", "pipeline": [{"$match": {"status": {"$foo": "paid"}}}]},
    {"id": "match-key-without-dollar", "server": "default", "collection": "order", "covers": "non-$ key inside a condition object → error", "pipeline": [{"$match": {"status": {"eq": "paid"}}}]},
    {"id": "match-unknown-field", "server": "default", "collection": "order", "covers": "unknown field → error", "pipeline": [{"$match": {"nope": 1}}]},
    {"id": "match-unlisted-field", "server": "default", "collection": "customer", "covers": "filter on a field outside `fields` (email) is accepted", "pipeline": [{"$match": {"email": "anna1@example.com"}}, {"$project": {"id": 1, "name": 1}}]},
    {"id": "extended-icontains", "server": "default", "collection": "order", "covers": "extra_filters icontains", "pipeline": [{"$match": {"number": {"$icontains": "ord-101"}}}, {"$sort": {"id": 1}}, {"$project": {"number": 1}}]},
    {"id": "extended-startswith", "server": "default", "collection": "order", "covers": "extra_filters startswith", "pipeline": [{"$match": {"number": {"$startswith": "ORD-100"}}}, {"$sort": {"id": 1}}, {"$project": {"number": 1}}]},
    {"id": "extended-year", "server": "default", "collection": "order", "covers": "extra_filters year on a datetime", "pipeline": [{"$match": {"placed_at": {"$year": 2025}}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "placed_at": 1}}]},
    {"id": "extended-not-enabled", "server": "default", "collection": "customer", "covers": "extended operator not in extra_filters → error", "pipeline": [{"$match": {"name": {"$icontains": "anna"}}}]},
    {"id": "text-single-word", "server": "default", "collection": "product", "covers": "$match.$text over search_fields", "pipeline": [{"$match": {"$text": {"$search": "laptop"}}}, {"$sort": {"sku": 1}}, {"$project": {"sku": 1, "name": 1}}]},
    {"id": "text-multi-word", "server": "default", "collection": "product", "covers": "$text: AND across words, OR across fields, case-insensitive", "pipeline": [{"$match": {"$text": {"$search": "GAMING laptop"}}}, {"$project": {"sku": 1}}]},
    {"id": "text-plus-field", "server": "default", "collection": "product", "covers": "$text combined with a field condition", "pipeline": [{"$match": {"$text": {"$search": "laptop"}, "in_stock": true}}, {"$sort": {"sku": 1}}, {"$project": {"sku": 1}}]},
    {"id": "text-unicode", "server": "default", "collection": "product", "covers": "$text with a non-ASCII word", "pipeline": [{"$match": {"$text": {"$search": "café"}}}, {"$project": {"sku": 1, "name": 1}}]},
    {"id": "text-unsupported", "server": "default", "collection": "lineitem", "covers": "$text on a collection without text fields → error", "pipeline": [{"$match": {"$text": {"$search": "x"}}}]},
    {"id": "text-default-fields", "server": "default", "collection": "customer", "covers": "default search fields = Char/Text fields within `fields`", "pipeline": [{"$match": {"$text": {"$search": "NL"}}}, {"$sort": {"id": 1}}, {"$project": {"id": 1, "name": 1}}]},
    {"id": "search-stage", "server": "default", "collection": "product", "covers": "$search stage", "pipeline": [{"$search": {"text": {"query": "phone"}}}, {"$sort": {"sku": 1}}, {"$project": {"sku": 1}}]},
    {"id": "search-path", "server": "default", "collection": "product", "covers": "$search with path", "pipeline": [{"$search": {"text": {"query": "knife", "path": "name"}}}, {"$project": {"sku": 1}}]},
    {"id": "search-path-invalid", "server": "default", "collection": "product", "covers": "$search path outside search_fields → error", "pipeline": [{"$search": {"text": {"query": "LAP", "path": "sku"}}}]},
    {"id": "sort-asc", "server": "default", "collection": "product", "covers": "$sort 1", "pipeline": [{"$sort": {"price": 1}}, {"$project": {"sku": 1, "price": 1}}]},
    {"id": "sort-desc", "server": "default", "collection": "product", "covers": "$sort -1", "pipeline": [{"$sort": {"price": -1}}, {"$project": {"sku": 1, "price": 1}}]},
    {"id": "sort-zero-is-desc", "server": "default", "collection": "product", "covers": "quirk: any direction other than 1 sorts descending", "pipeline": [{"$sort": {"price": 0}}, {"$project": {"sku": 1, "price": 1}}]},
    {"id": "sort-multi", "server": "default", "collection": "order", "covers": "multi-key sort", "pipeline": [{"$sort": {"status": 1, "total": -1}}, {"$project": {"number": 1, "status": 1, "total": 1}}]},
    {"id": "sort-on-alias", "server": "default", "collection": "order", "covers": "quirk: $sort does not translate lookup aliases → error", "pipeline": [{"$lookup": {"from": "customer", "localField": "customer", "foreignField": "_id", "as": "c"}}, {"$sort": {"c.name": 1}}, {"$project": {"number": 1}}]},
    {"id": "limit", "server": "default", "collection": "order", "covers": "$limit", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 3}, {"$project": {"id": 1}}]},
    {"id": "skip-then-limit", "server": "default", "collection": "order", "covers": "quirk: $skip is applied after $limit whatever the order (3 - 2 = 1 row)", "pipeline": [{"$sort": {"id": 1}}, {"$skip": 2}, {"$limit": 3}, {"$project": {"id": 1}}]},
    {"id": "limit-then-skip", "server": "default", "collection": "order", "covers": "$limit then $skip", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 5}, {"$skip": 2}, {"$project": {"id": 1}}]},
    {"id": "skip-only", "server": "default", "collection": "order", "covers": "$skip without $limit", "pipeline": [{"$sort": {"id": 1}}, {"$skip": 12}, {"$project": {"id": 1}}]},
    {"id": "project-include", "server": "default", "collection": "customer", "covers": "$project inclusion", "pipeline": [{"$sort": {"id": 1}}, {"$project": {"id": 1, "name": 1, "country": 1}}]},
    {"id": "project-underscore-id", "server": "default", "collection": "order", "covers": "$project _id → pk", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 2}, {"$project": {"_id": 1, "number": 1}}]},
    {"id": "project-rename", "server": "default", "collection": "order", "covers": "$project with a $field string", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 2}, {"$project": {"order_no": "$number", "key": "$_id"}}]},
    {"id": "project-zero-ignored", "server": "default", "collection": "order", "covers": "quirk: 0 is not an exclusion, the key is just skipped", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 2}, {"$project": {"number": 1, "status": 0}}]},
    {"id": "project-only-zero", "server": "default", "collection": "order", "covers": "quirk: exclusion-only $project → all columns", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 1}, {"$project": {"status": 0}}]},
    {"id": "project-nested", "server": "default", "collection": "order", "covers": "dotted output keys → nested objects", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 2}, {"$project": {"number": 1, "info.status": "$status", "info.total": "$total"}}]},
    {"id": "project-json-decimal-datetime", "server": "default", "collection": "order", "covers": "JSON, decimal and datetime rendering", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 3}, {"$project": {"number": 1, "total": 1, "placed_at": 1, "metadata": 1}}]},
    {"id": "no-project-all-columns", "server": "default", "collection": "customer", "covers": "quirk: no $project → every column (email, notes) despite `fields`; get_queryset scope applies", "pipeline": [{"$sort": {"id": 1}}]},
    {"id": "no-project-excluded-field", "server": "default", "collection": "order", "covers": "quirk: exclude_fields (metadata) still returned; FKs as <name>_id", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 2}]},
    {"id": "no-project-non-id-pk", "server": "default", "collection": "product", "covers": "string PK, JSON column, decimal", "pipeline": [{"$sort": {"sku": 1}}, {"$limit": 3}]},
    {"id": "empty-pipeline", "server": "default", "collection": "category", "covers": "no stages → whole collection", "pipeline": []},
    {"id": "empty-result", "server": "default", "collection": "order", "covers": "quirk: empty result returns [] unrendered (no content)", "pipeline": [{"$match": {"status": "nope"}}]},
    {"id": "collection-case", "server": "default", "collection": "Order", "covers": "collection name is case-insensitive", "pipeline": [{"$match": {"_id": 1}}, {"$project": {"number": 1}}]},
    {"id": "unknown-collection", "server": "default", "collection": "invoice", "covers": "unknown collection → error listing collections", "pipeline": []},
    {"id": "unsupported-stage", "server": "default", "collection": "order", "covers": "unsupported stage → error", "pipeline": [{"$unwind": "$items"}]},
    {"id": "lookup-basic", "server": "default", "collection": "order", "covers": "$lookup + $project of alias fields", "pipeline": [{"$lookup": {"from": "customer", "localField": "customer", "foreignField": "_id", "as": "c"}}, {"$sort": {"id": 1}}, {"$limit": 4}, {"$project": {"number": 1, "customer_name": "$c.name", "customer_country": "$c.country"}}]},
    {"id": "lookup-match-alias", "server": "default", "collection": "order", "covers": "$match on a lookup alias", "pipeline": [{"$lookup": {"from": "customer", "localField": "customer", "foreignField": "_id", "as": "c"}}, {"$match": {"c.country": "BE"}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "country": "$c.country"}}]},
    {"id": "lookup-after-use", "server": "default", "collection": "order", "covers": "quirk: $lookup is processed first wherever it appears", "pipeline": [{"$match": {"c.country": "DE"}}, {"$lookup": {"from": "customer", "localField": "customer", "foreignField": "_id", "as": "c"}}, {"$sort": {"id": 1}}, {"$project": {"number": 1}}]},
    {"id": "lookup-bypasses-target-scope", "server": "default", "collection": "order", "covers": "quirk: the target's get_queryset (active=True) is not applied", "pipeline": [{"$lookup": {"from": "customer", "localField": "customer", "foreignField": "_id", "as": "c"}}, {"$match": {"c.active": false}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "who": "$c.name"}}]},
    {"id": "lookup-unlisted-target-field", "server": "default", "collection": "order", "covers": "quirk: alias reaches fields outside the target's `fields` (email)", "pipeline": [{"$lookup": {"from": "customer", "localField": "customer", "foreignField": "_id", "as": "c"}}, {"$sort": {"id": 1}}, {"$limit": 2}, {"$project": {"number": 1, "email": "$c.email"}}]},
    {"id": "lookup-from-mismatch", "server": "default", "collection": "order", "covers": "quirk: `from` is not checked against the FK target", "pipeline": [{"$lookup": {"from": "product", "localField": "customer", "foreignField": "_id", "as": "c"}}, {"$sort": {"id": 1}}, {"$limit": 2}, {"$project": {"number": 1, "who": "$c.name"}}]},
    {"id": "lookup-from-unpublished", "server": "default", "collection": "order", "covers": "`from` not published → error", "pipeline": [{"$lookup": {"from": "user", "localField": "customer", "foreignField": "_id", "as": "c"}}]},
    {"id": "lookup-local-not-fk", "server": "default", "collection": "order", "covers": "localField not a many-to-one → error", "pipeline": [{"$lookup": {"from": "customer", "localField": "status", "foreignField": "_id", "as": "c"}}]},
    {"id": "lookup-foreign-bad", "server": "default", "collection": "order", "covers": "foreignField other than _id/pk/PK name → error", "pipeline": [{"$lookup": {"from": "customer", "localField": "customer", "foreignField": "name", "as": "c"}}]},
    {"id": "lookup-local-column-name", "server": "default", "collection": "order", "covers": "localField given as attname (customer_id)", "pipeline": [{"$lookup": {"from": "customer", "localField": "customer_id", "foreignField": "_id", "as": "c"}}, {"$sort": {"id": 1}}, {"$limit": 2}, {"$project": {"number": 1, "who": "$c.name"}}]},
    {"id": "lookup-id-mangling", "server": "default", "collection": "order", "covers": "quirk: localField.replace('_id','') mangles billing_identity", "pipeline": [{"$lookup": {"from": "customer", "localField": "billing_identity", "foreignField": "_id", "as": "b"}}, {"$match": {"b.country": "NL"}}, {"$project": {"number": 1}}]},
    {"id": "lookup-chain", "server": "default", "collection": "lineitem", "covers": "chained lookups through an alias", "pipeline": [{"$lookup": {"from": "order", "localField": "order", "foreignField": "_id", "as": "o"}}, {"$lookup": {"from": "customer", "localField": "o.customer", "foreignField": "_id", "as": "c"}}, {"$sort": {"id": 1}}, {"$limit": 4}, {"$project": {"id": 1, "order_no": "$o.number", "customer": "$c.name"}}]},
    {"id": "lookup-non-id-pk", "server": "default", "collection": "lineitem", "covers": "lookup into a string-PK target", "pipeline": [{"$lookup": {"from": "product", "localField": "product", "foreignField": "_id", "as": "p"}}, {"$match": {"p.category": 5}}, {"$sort": {"id": 1}}, {"$project": {"id": 1, "sku": "$p.sku", "name": "$p.name", "price": "$p.price"}}]},
    {"id": "lookup-self-reference", "server": "default", "collection": "category", "covers": "self-referencing FK", "pipeline": [{"$lookup": {"from": "category", "localField": "parent", "foreignField": "_id", "as": "parent_cat"}}, {"$sort": {"id": 1}}, {"$project": {"name": 1, "parent_name": "$parent_cat.name"}}]},
    {"id": "lookup-unknown-alias", "server": "default", "collection": "order", "covers": "unknown alias → error", "pipeline": [{"$match": {"x.name": "a"}}]},
    {"id": "group-null", "server": "default", "collection": "order", "covers": "$group _id null, $sum 1", "pipeline": [{"$group": {"_id": null, "n": {"$sum": 1}, "revenue": {"$sum": "$total"}}}]},
    {"id": "group-by-field", "server": "default", "collection": "order", "covers": "$group by one field", "pipeline": [{"$group": {"_id": "$status", "n": {"$sum": 1}, "revenue": {"$sum": "$total"}}}]},
    {"id": "group-after-match", "server": "default", "collection": "order", "covers": "$match then $group", "pipeline": [{"$match": {"status": {"$ne": "cancelled"}}}, {"$group": {"_id": "$customer", "orders": {"$count": 1}}}]},
    {"id": "group-avg-min-max", "server": "default", "collection": "product", "covers": "$avg/$min/$max", "pipeline": [{"$group": {"_id": "$category", "avg_price": {"$avg": "$price"}, "min_price": {"$min": "$price"}, "max_price": {"$max": "$price"}}}]},
    {"id": "group-count-field", "server": "default", "collection": "order", "covers": "$count with a field reference (non-null count)", "pipeline": [{"$group": {"_id": null, "orders": {"$count": 1}, "billed": {"$count": "$billing_identity"}}}]},
    {"id": "group-compound-id", "server": "default", "collection": "order", "covers": "compound _id with a lookup alias → nested _id", "pipeline": [{"$lookup": {"from": "customer", "localField": "customer", "foreignField": "_id", "as": "c"}}, {"$group": {"_id": {"status": "$status", "country": "$c.country"}, "n": {"$sum": 1}}}]},
    {"id": "group-by-alias", "server": "default", "collection": "lineitem", "covers": "group by a lookup alias field", "pipeline": [{"$lookup": {"from": "product", "localField": "product", "foreignField": "_id", "as": "p"}}, {"$group": {"_id": "$p.category", "qty": {"$sum": "$quantity"}}}]},
    {"id": "group-sum-1-non-id-pk", "server": "default", "collection": "product", "covers": "quirk: $sum 1 is Count('id') → fails on a model whose PK isn't id", "parity_deviation": "PLAN §1B: ror-mcp-server counts with COUNT(*) in both modes, so this succeeds", "pipeline": [{"$group": {"_id": null, "n": {"$sum": 1}}}]},
    {"id": "group-with-limit", "server": "default", "collection": "order", "covers": "$limit before $group (aggregate over a sliced queryset)", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 5}, {"$group": {"_id": null, "n": {"$sum": 1}}}]},
    {"id": "group-not-last", "server": "default", "collection": "order", "covers": "$group not last → error", "pipeline": [{"$group": {"_id": null, "n": {"$sum": 1}}}, {"$limit": 1}]},
    {"id": "group-after-project", "server": "default", "collection": "order", "covers": "$project before $group → error", "pipeline": [{"$project": {"status": 1}}, {"$group": {"_id": "$status", "n": {"$sum": 1}}}]},
    {"id": "group-bad-accumulator", "server": "default", "collection": "order", "covers": "unsupported accumulator → error", "pipeline": [{"$group": {"_id": null, "x": {"$push": "$number"}}}]},
    {"id": "group-bad-sum", "server": "default", "collection": "order", "covers": "$sum with a literal other than 1 → error", "pipeline": [{"$group": {"_id": null, "x": {"$sum": 2}}}]},
    {"id": "group-bad-id", "server": "default", "collection": "order", "covers": "_id that is not null/$field/object → error", "pipeline": [{"$group": {"_id": 5, "n": {"$sum": 1}}}]},

    {"id": "tool-get-server-instructions", "server": "default", "tool": "get_server_instructions", "arguments": {}, "covers": "instructions tool"},
    {"id": "tool-add", "server": "default", "tool": "add", "arguments": {"a": 2, "b": 5}, "covers": "custom tool returning an int"},
    {"id": "tool-dict", "server": "default", "tool": "customer_order_count", "arguments": {"customer_id": 2}, "covers": "custom tool returning a dict"},
    {"id": "tool-drf-serializer", "server": "default", "tool": "latest_order", "arguments": {}, "covers": "drf_serialize_output (decimal as string, datetime ISO)"},
    {"id": "tool-error", "server": "default", "tool": "explode", "arguments": {"reason": "boom"}, "covers": "exception → isError"},
    {"id": "tool-missing-arg", "server": "default", "tool": "add", "arguments": {"a": 1}, "covers": "missing required argument → isError"},
    {"id": "tool-unknown", "server": "default", "tool": "does_not_exist", "arguments": {}, "covers": "unknown tool → isError"},

    {"id": "analytics-csv", "server": "analytics", "collection": "order", "covers": "output_format csv", "pipeline": [{"$match": {"status": "paid"}}, {"$sort": {"id": 1}}, {"$project": {"number": 1, "total": 1, "placed_at": 1}}]},
    {"id": "analytics-csv-all-columns", "server": "analytics", "collection": "order", "covers": "csv without $project (all columns incl. JSON)", "pipeline": [{"$sort": {"id": 1}}, {"$limit": 2}]},
    {"id": "analytics-csv-group", "server": "analytics", "collection": "order", "covers": "csv of a $group with nested _id", "pipeline": [{"$group": {"_id": {"s": "$status"}, "n": {"$sum": 1}}}]},
    {"id": "analytics-resource", "server": "analytics", "collection": "vipcustomer", "covers": "output_as_resource → text + embedded JSON resource", "pipeline": [{"$sort": {"id": 1}}, {"$project": {"id": 1, "name": 1}}]},
    {"id": "analytics-resource-empty", "server": "analytics", "collection": "vipcustomer", "covers": "output_as_resource with no rows → 'No results found'", "pipeline": [{"$match": {"name": "nobody"}}]},
    {"id": "analytics-unpublished-collection", "server": "analytics", "collection": "customer", "covers": "collection published only on the other server → error", "pipeline": []},
