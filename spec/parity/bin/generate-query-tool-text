#!/usr/bin/env python3
"""
Regenerate lib/ror_mcp/tools/query_tool_text.rb from the django-mcp-server
submodule: PIPELINE_DSL_SPEC and the preamble of QueryTool.get_instructions,
copied exactly (trailing spaces and typos are part of the parity contract).
Run after updating the submodule:  spec/parity/bin/generate-query-tool-text
"""
import ast
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
SOURCE = ROOT / "django-mcp-server/mcp_server/query_tool.py"
TARGET = ROOT / "lib/ror_mcp/tools/query_tool_text.rb"

tree = ast.parse(SOURCE.read_text())
spec = next(n.value.value for n in tree.body
            if isinstance(n, ast.Assign) and getattr(n.targets[0], "id", None) == "PIPELINE_DSL_SPEC")
query_tool = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == "QueryTool")
get_instructions = next(f for f in query_tool.body if isinstance(f, ast.FunctionDef) and f.name == "get_instructions")
parts = get_instructions.body[0].value.values  # the f-string: literal, {PIPELINE_DSL_SPEC}, literal
assert [type(p).__name__ for p in parts] == ["Constant", "FormattedValue", "Constant"], "get_instructions changed shape"
before, after = parts[0].value, parts[2].value


def ruby_string(text):
    # A JSON string literal is a Ruby double-quoted literal once "#" can't start an interpolation.
    return json.dumps(text, ensure_ascii=False).replace("#", "\\#")


TARGET.write_text(f'''# frozen_string_literal: true

# GENERATED by spec/parity/bin/generate-query-tool-text from
# django-mcp-server/mcp_server/query_tool.py. Do not edit by hand: the text,
# trailing spaces and typos included, is part of the parity contract.
module RorMcp
  module Tools
    module QueryToolText
      PIPELINE_DSL_SPEC = {ruby_string(spec)}.freeze

      PREAMBLE = ({ruby_string(before)} + PIPELINE_DSL_SPEC + {ruby_string(after)}).freeze
    end
  end
end
''')
print(f"wrote {TARGET.relative_to(ROOT)}")
