      {
        "$limit": 2
      },
      {
        "$project": {
          "number": 1,
          "who": "$c.name"
        }
      }
    ],
    "server": "default"
  },
  "response": {
    "id": 68,
    "jsonrpc": "2.0",
    "result": {
      "content": [
        {
          "text": "Error executing tool query_data_collections: $lookup localField 'customer' points at Customer, not at the 'product' collection. Use \"from\": \"customer\".",
