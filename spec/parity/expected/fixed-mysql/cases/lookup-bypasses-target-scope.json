{
  "case": {
    "collection": "order",
    "covers": "quirk: the target's get_queryset (active=True) is not applied",
    "id": "lookup-bypasses-target-scope",
    "pipeline": [
      {
        "$lookup": {
          "as": "c",
          "foreignField": "_id",
          "from": "customer",
          "localField": "customer"
        }
      },
      {
        "$match": {
          "c.active": false
        }
      },
      {
        "$sort": {
          "id": 1
        }
      },
      {
        "$project": {
          "number": 1,
          "who": "$c.name"
        }
      }
    ],
    "server": "default"
  },
  "response": {
    "id": 66,
    "jsonrpc": "2.0",
    "result": {
      "content": [
        {
          "text": "[]",
          "type": "text"
        }
      ],
      "isError": false
    }
  }
}
