{
  "case": {
    "collection": "order",
    "covers": "output_format csv",
    "id": "analytics-csv",
    "pipeline": [
      {
        "$match": {
          "status": "paid"
        }
      },
      {
        "$sort": {
          "id": 1
        }
      },
      {
        "$project": {
          "number": 1,
          "placed_at": 1,
          "total": 1
        }
      }
    ],
    "server": "analytics"
  },
  "response": {
    "id": 3,
    "jsonrpc": "2.0",
    "result": {
      "content": [
        {
          "text": "number,placed_at,total\r\nORD-1003,2025-01-11 22:10:00+00:00,6549.00\r\nORD-1007,2025-04-13 15:32:00+00:00,699.00\r\nORD-1011,2025-07-14 12:56:00+00:00,4556.98\r\n",
          "type": "text"
        }
      ],
      "isError": false
    }
  }
}
