{
  "case": {
    "collection": "order",
    "covers": "$lookup + $project of alias fields",
    "id": "lookup-basic",
    "pipeline": [
      {
        "$lookup": {
          "as": "c",
          "foreignField": "_id",
          "from": "customer",
          "localField": "customer"
        }
      },
      {
        "$sort": {
          "id": 1
        }
      },
      {
        "$limit": 4
      },
      {
        "$project": {
          "customer_country": "$c.country",
          "customer_name": "$c.name",
          "number": 1
        }
      }
    ],
    "server": "default"
  },
  "response": {
    "id": 63,
    "jsonrpc": "2.0",
    "result": {
      "content": [
        {
          "text": "[{\"number\":\"ORD-1001\",\"customer_name\":\"Bram Peeters\",\"customer_country\":\"BE\"},{\"number\":\"ORD-1002\",\"customer_name\":\"Bram Peeters\",\"customer_country\":\"BE\"},{\"number\":\"ORD-1003\",\"customer_name\":\"Anna de Vries\",\"customer_country\":\"NL\"},{\"number\":\"ORD-1004\",\"customer_name\":\"Clara Müller\",\"customer_country\":\"DE\"}]",
          "type": "text"
        }
      ],
      "isError": false
    }
  }
}
