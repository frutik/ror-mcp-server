{
  "case": {
    "collection": "order",
    "covers": "quirk: $lookup is processed first wherever it appears",
    "id": "lookup-after-use",
    "pipeline": [
      {
        "$match": {
          "c.country": "DE"
        }
      },
      {
        "$lookup": {
          "as": "c",
          "foreignField": "_id",
          "from": "customer",
          "localField": "customer"
        }
      },
      {
        "$sort": {
          "id": 1
        }
      },
      {
        "$project": {
          "number": 1
        }
      }
    ],
    "server": "default"
  },
  "response": {
    "id": 65,
    "jsonrpc": "2.0",
    "result": {
      "content": [
        {
          "text": "[{\"number\":\"ORD-1004\"},{\"number\":\"ORD-1008\"},{\"number\":\"ORD-1010\"}]",
          "type": "text"
        }
      ],
      "isError": false
    }
  }
}
