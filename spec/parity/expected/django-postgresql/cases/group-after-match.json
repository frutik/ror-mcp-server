{
  "case": {
    "collection": "order",
    "covers": "$match then $group",
    "id": "group-after-match",
    "pipeline": [
      {
        "$match": {
          "status": {
            "$ne": "cancelled"
          }
        }
      },
      {
        "$group": {
          "_id": "$customer",
          "orders": {
            "$count": 1
          }
        }
      }
    ],
    "server": "default"
  },
  "response": {
    "id": 80,
    "jsonrpc": "2.0",
    "result": {
      "content": [
        {
          "text": "[{\"orders\":1,\"customer\":3},{\"orders\":1,\"customer\":5},{\"orders\":2,\"customer\":6},{\"orders\":3,\"customer\":2},{\"orders\":2,\"customer\":7},{\"orders\":1,\"customer\":1}]",
          "type": "text"
        }
      ],
      "isError": false
    }
  }
}
