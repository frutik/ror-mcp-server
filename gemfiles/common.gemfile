# frozen_string_literal: true

# Development gems shared by ../Gemfile and the per-Rails gemfiles CI uses.
gem "rake", "~> 13.0"
gem "rspec", "~> 3.13"
gem "rack-test", "~> 2.1"

# Database adapters for the spec matrix (RORMCP_TEST_DATABASE_URL picks one; SQLite by default).
gem "pg", ">= 1.5"
gem "trilogy", ">= 2.9"
